{
  "note": "mechanical sanitization of Git-bound evidence: path prefixes and local identifiers only; no number changed; originals kept locally, outside Git",
  "originals_directory": "artifacts/increment9/original-evidence",
  "originals_in_git": false,
  "rules": [
    {
      "id": "repo-root",
      "pattern": "/home/[^/\"\\s]+/(?:[^/\"\\s]+/)*?ooc-inference(?![\\w.-])",
      "replacement": "<repo>",
      "description": "absolute path of the local repository checkout -> <repo>"
    },
    {
      "id": "session-scratch",
      "pattern": "/tmp/[a-z]+-[0-9]+/[^/\"\\s]+/[0-9a-f-]{36}/scratchpad",
      "replacement": "<scratch>",
      "description": "per-session scratch directory of the acquisition session -> <scratch>"
    },
    {
      "id": "terminal-session",
      "pattern": "tmux-spawn-[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}",
      "replacement": "tmux-spawn-<session>",
      "description": "random identifier of the local terminal session scope -> tmux-spawn-<session>"
    },
    {
      "id": "unrelated-hf-cache",
      "pattern": "entries of huggingface_hub_cache_entries naming none of Qwen/SmolLM",
      "replacement": "(dropped)",
      "description": "Hugging Face cache entries unrelated to the project are removed from the list"
    }
  ],
